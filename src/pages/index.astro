      <div class="topbar-actions">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar a modo claro" aria-pressed="true" title="Cambiar tema">
          <span aria-hidden="true">☀︎</span>
        </button>
        <a class="button button-small" href="#contacto">Crear mi proyecto</a>
      </div>
    </header>

    <section class="hero" id="home">
      <div class="hero-copy reveal reveal-delay-1">
