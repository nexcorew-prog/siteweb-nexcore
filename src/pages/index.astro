      <div class="contact-actions">
        <a class="button" href="https://wa.me/59169436988" target="_blank" rel="noreferrer">Escribir por WhatsApp</a>
        <a class="contact-link" href="tel:+59169436988"><span>Teléfono</span><strong>+591 69436988</strong></a>
        <a class="contact-link" href="mailto:nexcorew@gmail.com"><span>Correo</span><strong>nexcorew@gmail.com</strong></a>
