---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="page-shell">
    <header class="topbar reveal reveal-delay-1">
      <a class="brand" href="#home">
        <span>Nexcore</span>
      </a>
      <nav class="nav-links" aria-label="Navegación principal">
