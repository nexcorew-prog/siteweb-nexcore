  </main>

  <footer class="footer">
    <div>
      <strong>Nexcore</strong>
      <p>Diseño web, tiendas online y sistemas para negocios en Bolivia.</p>
    </div>
    <div>
      <a href="#servicios">Servicios</a>
      <a href="#soluciones">Soluciones</a>
      <a href="#preguntas">Preguntas frecuentes</a>
      <a href="tel:+59169436988">+591 69436988</a>
      <a href="mailto:nexcorew@gmail.com">nexcorew@gmail.com</a>
    </div>
  </footer>

  <script>
    const toggleButton = document.getElementById('theme-toggle');
    const root = document.documentElement;

    const setTheme = (theme: string) => {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      localStorage.setItem('theme', theme);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0b0f19' : '#edf4f7');
      if (toggleButton) {
        toggleButton.innerHTML = theme === 'dark' ? '<span aria-hidden="true">☀︎</span>' : '<span aria-hidden="true">☾</span>';
        toggleButton.setAttribute('aria-label', theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
        toggleButton.setAttribute('aria-pressed', String(theme === 'dark'));
      }
    };

    const storedTheme = localStorage.getItem('theme');
    const preferredTheme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    setTheme(preferredTheme);

    toggleButton?.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      setTheme(nextTheme);
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pageShell = document.querySelector<HTMLElement>('.page-shell');
    const storySections = Array.from(document.querySelectorAll<HTMLElement>('[data-story-section]'));

    const updateScrollStories = () => {
      storySections.forEach((section) => {
        const stage = section.querySelector<HTMLElement>('.story-stage');
        const items = Array.from(section.querySelectorAll<HTMLElement>('[data-story-item]'));
        if (!stage || !items.length) return;

        const sectionBounds = section.getBoundingClientRect();
        const stickyTop = Number.parseFloat(window.getComputedStyle(stage).top) || 0;
        const scrollableDistance = section.offsetHeight - stage.offsetHeight;
        const progress = scrollableDistance > 0
          ? Math.max(0, Math.min(0.9999, (stickyTop - sectionBounds.top) / scrollableDistance))
          : 0;
        const activeIndex = Math.min(items.length - 1, Math.floor(progress * items.length));

        items.forEach((item, index) => {
          const isActive = index === activeIndex;
          item.classList.toggle('is-current', isActive);
          item.setAttribute('aria-hidden', String(!isActive));
        });

        const current = section.querySelector<HTMLElement>('[data-story-current]');
        const progressBar = section.querySelector<HTMLElement>('[data-story-progress]');
        if (current) current.textContent = String(activeIndex + 1).padStart(2, '0');
        if (progressBar) progressBar.style.transform = `scaleX(${(activeIndex + 1) / items.length})`;
      });
    };

    if (!prefersReducedMotion) {
      const revealElements = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.16 }
      );

      revealElements.forEach((element) => revealObserver.observe(element));
    } else {
      document.querySelectorAll('.reveal').forEach((element) => element.classList.add('is-visible'));
    }

    const parallaxElements = document.querySelectorAll<HTMLElement>('[data-parallax]');
    let scrollFrame = 0;

    const updateParallax = () => {
      scrollFrame = 0;
      const viewportCenter = window.innerHeight / 2;
      const mobileScale = window.innerWidth < 640 ? 0.55 : 1;
      const updates: Array<[HTMLElement, string]> = [];

      parallaxElements.forEach((element) => {
        const bounds = element.getBoundingClientRect();
        const distanceFromCenter = bounds.top + bounds.height / 2 - viewportCenter;
        const speed = Number(element.dataset.parallax) * mobileScale;
        const offset = Math.max(-52, Math.min(52, -distanceFromCenter * speed));
        updates.push([element, `${offset.toFixed(1)}px`]);
      });

      updates.forEach(([element, offset]) => element.style.setProperty('--parallax-offset', offset));
      updateScrollStories();
    };

    const requestParallaxUpdate = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateParallax);
    };

    if (!prefersReducedMotion && parallaxElements.length) {
      pageShell?.classList.add('has-scroll-stories');
      updateScrollStories();
      window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
      window.addEventListener('resize', requestParallaxUpdate);
      updateParallax();
    }
  </script>
</Layout>

<style>
  .page-shell {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.25rem 0 3rem;
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 { transition-delay: 80ms; }
  .reveal-delay-2 { transition-delay: 160ms; }
  .reveal-delay-3 { transition-delay: 240ms; }
  .reveal-delay-4 { transition-delay: 320ms; }
  .reveal-delay-5 { transition-delay: 400ms; }
  .reveal-delay-6 { transition-delay: 480ms; }

  [data-parallax] {
    translate: 0 var(--parallax-offset, 0px);
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    margin-top: 0.75rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-nav);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 14px 40px var(--glass-shadow);
    backdrop-filter: blur(22px) saturate(165%);
    -webkit-backdrop-filter: blur(22px) saturate(165%);
    transition: background 360ms ease, border-color 360ms ease, box-shadow 360ms ease;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .brand-mark {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 0.25rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 20px rgba(99, 172, 241, 0.3);
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    color: var(--text-secondary);
  }

  .nav-links a:hover,
  .footer a:hover {
    color: var(--text-primary);
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-panel-strong);
    color: var(--text-primary);
    cursor: pointer;
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 6px 18px var(--glass-shadow);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    transition: transform 220ms ease, border-color 360ms ease, background 360ms ease, color 360ms ease;
  }

  .theme-toggle:hover {
    transform: translateY(-1px) rotate(8deg);
    border-color: var(--glass-accent-border);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.2rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white;
    font-weight: 700;
    transition: transform 220ms ease, box-shadow 220ms ease;
    box-shadow: 0 10px 30px rgba(99, 184, 241, 0.24);
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(99, 165, 241, 0.35);
  }

  .button-small {
    padding: 0.7rem 1rem;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .button-secondary {
    background: var(--glass-panel);
    color: var(--text-primary);
    border: 1px solid var(--glass-border);
    box-shadow: none;
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: center;
    padding: 4rem 0 3rem;
  }

  .eyebrow {
    display: inline-flex;
    margin: 0 0 0.8rem;
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 1.05;
    margin-bottom: 1rem;
    max-width: 11ch;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.5rem 0 1.2rem;
  }

  .hero-actions .button,
  .cta-section .button {
    width: fit-content;
  }

  .hero-points {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
    list-style: none;
    color: var(--text-secondary);
  }

  .hero-points li::before {
    content: '•';
    color: var(--accent);
    margin-right: 0.6rem;
  }

  .hero-visual {
    position: relative;
    min-height: 430px;
    padding: 0 0.5rem 1rem;
    isolation: isolate;
  }

  .hero-image-frame {
    position: relative;
    width: min(100%, 560px);
    height: clamp(22rem, 42vw, 35rem);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 48% 48% 1.6rem 1.6rem;
    background: var(--glass-panel);
    box-shadow: 0 28px 72px var(--glass-shadow);
    transform: rotate(1deg);
  }

  .hero-image-frame::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgba(8, 20, 28, 0.72));
    content: '';
  }

  .hero-image-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: heroImageEnter 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-image-frame figcaption {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    color: white;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 600;
  }

  .service-image {
    width: 100%;
    height: clamp(10rem, 22vw, 16rem);
    margin: 0 0 1rem;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 0.9rem;
    background: var(--glass-panel);
  }

  .service-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-item:hover .service-image img {
    transform: scale(1.045);
  }

  .floating-card {
    position: absolute;
    right: -1rem;
    bottom: 1.3rem;
    padding: 0.95rem 1.1rem;
    border-radius: 1rem;
    background: var(--glass-accent);
    border: 1px solid var(--glass-accent-border);
    color: var(--text-primary);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 16px 36px var(--glass-shadow);
    backdrop-filter: blur(20px) saturate(170%);
    -webkit-backdrop-filter: blur(20px) saturate(170%);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1rem 0 2rem;
  }

  .metrics > div {
    padding: 1.2rem;
    border-radius: 1rem;
    background: var(--glass-panel);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 12px 32px var(--glass-shadow);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transition: background 360ms ease, border-color 360ms ease, box-shadow 360ms ease;
  }

  .metrics strong,
  .benefits-list strong {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 1rem;
  }

  .metrics span,
  .benefits-list p,
  .project-content p,
  .card p,
  .process-step p,
  .footer p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .section {
    padding: 3rem 0;
  }

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    max-width: 700px;
  }

  .section-heading.left h2 {
    max-width: 620px;
  }

  .story-section {
    position: relative;
  }

  .story-services { --story-count: 4; --story-runway: 232svh; }
  .story-process { --story-count: 4; --story-runway: 232svh; }
  .story-projects { --story-count: 2; --story-runway: 116svh; }

  .story-stage {
    position: relative;
  }

  .story-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .story-heading-row .section-heading {
    margin-bottom: 1.5rem;
  }

  .story-meter {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.3rem;
    flex: 0 0 auto;
    padding-bottom: 1.5rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .story-meter [data-story-current] {
    color: var(--text-primary);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .story-track {
    grid-column: 1 / -1;
    width: 5rem;
    height: 2px;
    margin-top: 0.55rem;
    overflow: hidden;
    background: var(--glass-border);
  }

  .story-track span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0.25);
    transform-origin: left center;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-items {
    display: grid;
  }

  .page-shell.has-scroll-stories .story-section {
    height: calc(var(--story-runway) + 92svh);
    padding: 0;
  }

  .page-shell.has-scroll-stories .story-stage {
    position: sticky;
    top: 4svh;
    display: flex;
    flex-direction: column;
    height: max(540px, 92svh);
    padding: clamp(1.25rem, 4vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, var(--glass-panel-strong), var(--glass-panel));
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 24px 64px var(--glass-shadow);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
  }

  .page-shell.has-scroll-stories .story-heading-row {
    flex: 0 0 auto;
  }

  .page-shell.has-scroll-stories .story-items {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: block;
  }

  .page-shell.has-scroll-stories .story-item {
    position: absolute;
    inset: 0;
    display: flex;
    width: 100%;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(3rem) scale(0.97);
    transition: opacity 600ms ease, transform 750ms cubic-bezier(0.22, 1, 0.36, 1), visibility 600ms;
  }

  .page-shell.has-scroll-stories .story-item.is-current {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition-delay: 0ms;
  }

  .page-shell.has-scroll-stories .story-item h3 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .page-shell.has-scroll-stories .story-item p {
    max-width: 38rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.8;
  }

  .page-shell.has-scroll-stories .story-item > span:not(.story-tag) {
    margin-top: 1.5rem;
    font-size: 1rem;
  }

  .page-shell.has-scroll-stories .story-process .story-item {
    flex-direction: row;
    align-items: center;
    gap: clamp(1.5rem, 6vw, 5rem);
  }

  .page-shell.has-scroll-stories .story-process .story-item > span {
    flex: 0 0 auto;
    padding: 0;
    color: var(--accent);
    font-size: clamp(4rem, 13vw, 9rem);
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    opacity: 0.78;
  }

  .page-shell.has-scroll-stories .story-projects .story-item {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .page-shell.has-scroll-stories .story-projects .project-preview {
    height: 100%;
    min-height: 16rem;
    margin: 0;
  }

  .page-shell.has-scroll-stories .story-projects .project-content span {
    margin-top: 1.25rem;
  }

  .page-shell.has-scroll-stories .story-services .story-item {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(16rem, 1.1fr);
    grid-template-rows: auto 1fr auto;
    align-content: center;
    column-gap: clamp(1.5rem, 6vw, 6rem);
    overflow: hidden;
  }

  .page-shell.has-scroll-stories .story-services .service-image {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1 / 4;
    height: 100%;
    min-height: 14rem;
    margin: 0;
    border-radius: 1.2rem;
  }

  .page-shell.has-scroll-stories .story-services .story-item::before {
    position: absolute;
    top: -0.18em;
    right: 0.12em;
    color: var(--accent);
    content: attr(data-story-number);
    font-size: clamp(8rem, 24vw, 19rem);
    font-weight: 700;
    line-height: 1;
    opacity: 0.075;
    pointer-events: none;
  }

  .page-shell.has-scroll-stories .story-services .story-item h3 {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    max-width: 10ch;
  }

  .page-shell.has-scroll-stories .story-services .story-item p,
  .page-shell.has-scroll-stories .story-services .story-item > span {
    position: relative;
    z-index: 1;
    grid-column: 1;
  }

  .page-shell.has-scroll-stories .story-services .story-item p {
    grid-row: 2;
  }

  .page-shell.has-scroll-stories .story-services .story-item > span {
    grid-row: 3;
    align-self: end;
  }

  .page-shell.has-scroll-stories .story-process .story-stage {
    top: 8svh;
    height: max(500px, 84svh);
    padding: 1.5rem 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .page-shell.has-scroll-stories .story-process .story-heading-row {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .page-shell.has-scroll-stories .story-process .story-items {
    margin: 1rem 0 0 clamp(0rem, 4vw, 3rem);
    padding-left: clamp(1.5rem, 4vw, 3.5rem);
    border-left: 1px solid var(--glass-accent-border);
  }

  .page-shell.has-scroll-stories .story-process .story-item {
    gap: clamp(1rem, 4vw, 3rem);
    padding: 2rem clamp(1rem, 4vw, 3rem);
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .page-shell.has-scroll-stories .story-process .story-item > span {
    font-size: clamp(4rem, 11vw, 8rem);
    opacity: 0.35;
  }

  .page-shell.has-scroll-stories .story-process .story-item > div {
    padding-left: clamp(1rem, 4vw, 3.5rem);
    border-left: 1px solid var(--glass-border);
  }

  .page-shell.has-scroll-stories .story-projects .story-stage {
    top: 3svh;
    height: max(540px, 94svh);
    padding: clamp(1rem, 2vw, 1.75rem) 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .page-shell.has-scroll-stories .story-projects .story-heading-row {
    padding: 0 clamp(0rem, 2vw, 1.5rem);
  }

  .page-shell.has-scroll-stories .story-projects .story-item {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .page-shell.has-scroll-stories .story-projects .project-preview {
    min-height: 22rem;
    border-radius: 1.5rem;
    box-shadow: 0 28px 72px var(--glass-shadow);
  }

  .page-shell.has-scroll-stories .story-projects .project-content {
    padding: 1.5rem 0;
  }

  .page-shell.has-scroll-stories .story-projects .project-content h3 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .card,
  .project-card,
  .benefits-list > div,
  .process-step {
    padding: 1.2rem;
    border-radius: 1.2rem;
    background: var(--glass-panel);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 12px 32px var(--glass-shadow);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transition: transform 220ms ease, border-color 360ms ease, background 360ms ease, box-shadow 360ms ease;
  }

  .card:hover,
  .project-card:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: var(--glass-accent-border);
  }

  .card h3,
  .project-content h3,
  .process-step h3 {
    margin-bottom: 0.55rem;
  }

  .card span {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--accent);
    font-weight: 600;
  }

  .split-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .process-list {
    display: grid;
    gap: 0.9rem;
  }

  .process-step {
    display: flex;
    gap: 1rem;
    align-items: start;
  }

  .process-step span {
    color: var(--accent);
    font-weight: 700;
    padding-top: 0.2rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-preview {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    height: 180px;
    border-radius: 1rem;
    margin-bottom: 1rem;
    background: var(--glass-preview);
    border: 1px solid var(--glass-border);
  }

  .preview-window {
    width: 70%;
    height: 78%;
    padding: 0.65rem;
    border: 1px solid var(--glass-border);
    border-radius: 0.8rem;
    background: var(--glass-panel-strong);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 36px var(--glass-shadow);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
  }

  .preview-window-top {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.55rem;
  }

  .preview-window-top i {
    width: 0.35rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(148, 163, 184, 0.6);
  }

  .preview-dashboard {
    display: grid;
    grid-template-columns: 0.3fr 1fr;
    gap: 0.5rem;
    height: calc(100% - 1rem);
  }

  .preview-sidebar {
    border-radius: 0.3rem;
    background: linear-gradient(180deg, rgba(99, 165, 241, 0.7), rgba(99, 165, 241, 0.08));
  }

  .preview-chart {
    display: flex;
    align-items: end;
    gap: 0.35rem;
    padding: 0.35rem;
    border-radius: 0.35rem;
    background: rgba(148, 163, 184, 0.08);
  }

  .preview-chart span {
    flex: 1;
    height: 42%;
    border-radius: 0.2rem 0.2rem 0 0;
    background: linear-gradient(180deg, #63a5f1, rgba(99, 165, 241, 0.28));
  }

  .preview-chart span:nth-child(2) { height: 68%; }
  .preview-chart span:nth-child(3) { height: 50%; }
  .preview-chart span:nth-child(4) { height: 82%; }
  .preview-chart span:nth-child(5) { height: 62%; }

  .preview-stat,
  .store-tag {
    position: absolute;
    right: 7%;
    bottom: 12%;
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--glass-border);
    border-radius: 0.6rem;
    background: var(--glass-panel-strong);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 12px 24px var(--glass-shadow);
    backdrop-filter: blur(16px) saturate(155%);
    -webkit-backdrop-filter: blur(16px) saturate(155%);
  }

  .preview-stat strong { color: #86efac; font-size: 0.85rem; }
  .preview-stat span { color: var(--text-secondary); font-size: 0.65rem; }

  .store-phone {
    width: 5.2rem;
    height: 8rem;
    padding: 0.35rem;
    border: 1px solid rgba(148, 163, 184, 0.45);
    border-radius: 1rem;
    background: #101827;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.3);
  }

  .store-screen {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 0.35rem;
    border-radius: 0.7rem;
    background: #f8fafc;
  }

  .store-product {
    min-height: 3rem;
    border-radius: 0.45rem;
    background: linear-gradient(145deg, rgba(34, 197, 94, 0.72), rgba(99, 165, 241, 0.62));
  }

  .store-line {
    height: 0.25rem;
    border-radius: 1rem;
    background: #cbd5e1;
  }

  .store-line.short { width: 65%; }

  .store-buy {
    align-self: end;
    height: 0.55rem;
    border-radius: 1rem;
    background: #469de5;
  }

  .store-tag {
    right: 8%;
    bottom: 18%;
    display: block;
    color: var(--text-primary);
    font-size: 0.68rem;
  }

  .preview-one {
    background-image: radial-gradient(circle at top left, rgba(255,255,255,0.16), transparent 35%), linear-gradient(135deg, rgba(99, 137, 241, 0.25), rgba(17, 24, 39, 0.95));
  }

  .preview-two {
    background-image: linear-gradient(135deg, rgba(34, 197, 94, 0.17), rgba(17, 24, 39, 0.95));
  }

  .project-content span {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--accent-2);
    font-weight: 600;
  }

  .benefits-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1.5rem;
  }

  .benefits-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .faq-section {
    width: min(100%, 900px);
    margin: 0 auto;
  }

  .faq-item {
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--glass-border);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-primary);
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    color: var(--accent);
    content: '+';
    font-size: 1.4rem;
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: '\2212';
  }

  .faq-item p {
    max-width: 46rem;
    padding: 0.8rem 2rem 0.25rem 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .cta-section {
    padding: 2rem;
    border-radius: 1.6rem;
    text-align: center;
    background: linear-gradient(135deg, var(--glass-accent), var(--glass-panel));
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 44px var(--glass-shadow);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    transition: background 360ms ease, border-color 360ms ease, box-shadow 360ms ease;
  }

  .cta-section h2 {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    margin-bottom: 0.8rem;
  }

  .cta-section p {
    color: var(--text-secondary);
    margin-bottom: 1.2rem;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
  }

  .contact-link {
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.75rem;
    transition: color 200ms ease, background 200ms ease;
  }

  .contact-link:hover {
    background: var(--glass-panel);
    color: var(--accent);
  }

  .contact-link span {
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 3rem;
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    color: var(--text-secondary);
  }

  .footer > div:last-child {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @keyframes heroImageEnter {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .reveal,
    .reveal.is-visible,
    [data-parallax],
    .hero-image-frame img,
    .service-image img,
    .button,
    .card,
    .project-card,
    .theme-toggle {
      transition: none;
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero,
    .split-section,
    .benefits-section {
      grid-template-columns: 1fr;
    }

    .services-grid,
    .projects-grid,
    .benefits-list,
    .metrics {
      grid-template-columns: 1fr;
    }

    .nav-links {
      display: none;
    }

    .topbar {
      border-radius: 1.2rem;
